#!/usr/bin/env bash
# shellcheck shell=bash

# Configuration-file helpers for bwx.
#
# Credentials resolve from the environment first and fall back to
# per-value files under an XDG configuration directory. The file layer
# exists because a non-interactive shell never sources ~/.bashrc past
# its interactive guard, so a token exported from a login profile is
# invisible to cron, `ssh host command`, and systemd -- exactly the
# unattended callers that most need it. A file under $HOME is visible
# to all of them and survives redeployment of any working tree.

